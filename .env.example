# gen-UAT deployment values. Read by docker compose from this directory (no --env-file needed)
# and by jenkins/deploy.sh. Empty values marked ${VAR:?} in docker-compose.yml block startup.

# --- existing Postgres container on this VM (never restarted by this stack) ---
PG_CONTAINER=dev-postgres                      # docker ps name; gets the alias db.openelis.org on openelis-network
OE_DB_PORT=5444                    # port Postgres listens on INSIDE its container (`show port`)
PG_SUPERUSER=postgres                    # used by db-init only, to create role/database; the app never sees it
PG_SUPERUSER_PASSWORD=postgres
OE_DB_PASSWORD=                    # db-init creates role clinlims with this; the app connects with it

# --- this deployment ---
OE_SITE_CODE=                      # replaces DEV01: site number + accession-number prefix (immutable once samples exist)
OE_UI_LOCAL_PORT=3000              # 127.0.0.1 only: the host nginx proxies /     to it
OE_API_LOCAL_PORT=8443             # 127.0.0.1 only: the host nginx proxies /api/ to it
TZ=                                # the VM's zone, e.g. Asia/Kolkata
OE_DATA_DIR=/srv/openelis/uat      # customer uploads live in $OE_DATA_DIR/nce-attachments, outside this clone

# --- keystore/truststore for oe <-> fhir TLS (generated once by the certs service; change BEFORE first up) ---
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass
